
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: linear-gradient(135deg, #101827, #243b55);
    font-family: Arial, sans-serif;
    color: #eaf1ff;
}

.card {
    width: min(100%, 420px);
    padding: 36px;
    border: 1px solid #40516d;
    border-radius: 22px;
    background: #1b2638;
    text-align: center;
    box-shadow: 0 20px 50px #0005;
}

.avatar {
    width: 90px;
    height: 90px;
    margin: auto;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #293d5b;
    font-size: 48px;
}

h1 {
    font-size: 28px;
}

h1 span {
    color: #69d6ff;
}

.role {
    color: #9fb4d2;
    font-weight: bold;
}

p {
    line-height: 1.6;
}

button {
    border: 0;
    border-radius: 10px;
    padding: 12px 22px;
    background: #39b8e8;
    color: #071522;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #78dcff;
}

#message {
    min-height: 24px;
    color: #8ee6b0;
}

footer {
    margin-top: 24px;
    color: #8194af;
    font-size: 12px;
}
